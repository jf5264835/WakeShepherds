# Public URL used in OAuth callbacks and links sent by email.
APP_BASE_URL=http://localhost:3000

# Optional comma-separated hostnames for development through a proxy or custom
# local DNS name. Network-interface IP addresses are allowed automatically.
ALLOWED_DEV_ORIGINS=

# Local SQLite is the simplest option for one persistent server.
DATABASE_URL=file:./data/shepherding.db

# Leave blank for a local file. Set this when using a hosted libSQL database.
DATABASE_AUTH_TOKEN=

# Used only to create the first Global Admin account.
# Initial username: global-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Separate 32+ character secret used to encrypt Google and Planning Center tokens.
# Do not change this after connecting integrations unless you first disconnect them.
ENCRYPTION_SECRET=replace-with-a-different-long-random-secret
